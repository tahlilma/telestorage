# ─────────────────────────────────────────────────────────────────────────────
#  Telestorage — configuration. Copy to .env and fill in what you need.
#  Only AUTH_PASSWORD is required to start; without the
#  TG_* values files are stored on local disk (same pipeline, dev driver).
# ─────────────────────────────────────────────────────────────────────────────

# ── Sign-in ──────────────────────────────────────────────────────────────────
AUTH_PASSWORD=change-me
# Optional TOTP (base32 secret from any authenticator app setup).
AUTH_TOTP_SECRET=
# Session signing secret. Leave empty: it's kept in DATA_DIR, or — on a host that
# wipes its disk — derived from your bot tokens, so restarts don't sign you out.
AUTH_SECRET=
SESSION_DAYS=30

# The address you reach the app at (secure cookies and the links you share).
PUBLIC_URL=

# ── Telegram storage ─────────────────────────────────────────────────────────
# https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# Two to four @BotFather bots, comma-separated. Each must be an admin of the
# channel with Post, Delete and Pin rights. More bots = more parallel lanes.
TG_BOT_TOKENS=
# Run `npm run tg:setup` to discover it (looks like -100…).
TG_CHANNEL_ID=
# MTProto connections per bot (1–8) and in-flight requests per connection.
TG_CONNECTIONS_PER_BOT=4
TG_CONCURRENCY=8
# Size of each stored part in MiB (max 2000). A file is stored as one Telegram post
# per part, so there is no limit on file size; each post holds up to this much.
TG_PART_SIZE_MB=512
# sendMedia pacing per bot (Telegram allows about 20 posts/minute per chat).
TG_COMMITS_PER_MINUTE=20
# Hedged reads: send a backup request to another bot when one is slow.
TG_HEDGING=true

# Force a driver: telegram | local | sim (sim = simulated bots, for testing).
STORAGE_DRIVER=

# ── Encryption ───────────────────────────────────────────────────────────────
# 64 hex chars or any passphrase. Telegram then only ever stores ciphertext.
# LOSE THIS AND YOUR FILES ARE UNRECOVERABLE.
ENCRYPTION_KEY=

# ── Uploads & integrity ──────────────────────────────────────────────────────
# Chunk bytes the server buffers in flight before queueing (load shedding → 503).
UPLOAD_BUFFER_MB=384
UPLOAD_QUEUE_TIMEOUT_MS=15000
# Pieces of one chunk sent to storage concurrently.
UPLOAD_PIECE_PARALLELISM=8
# Days an interrupted upload can be continued (pick the same file again). Its
# finished parts stay in the channel until then; after that they are deleted.
UPLOAD_RESUME_DAYS=7
# Idle read-back verification speed in MiB/s (0 disables the scrubber).
SCRUB_MBPS=8
# Metadata consistency check interval (0 = boot only).
FSCK_INTERVAL_HOURS=6

# ── Housekeeping ─────────────────────────────────────────────────────────────
# Days items stay in the trash before being deleted for good (0 = never).
TRASH_RETENTION_DAYS=30
# Earlier versions kept per file when you upload over it (oldest go first).
VERSIONS_KEEP=25
# Index backups, pinned in the channel (encrypted when ENCRYPTION_KEY is set).
# They follow changes: BACKUP_DELAY_SEC after things go quiet, at the latest
# BACKUP_MAX_DELAY_SEC after the first unsaved change, and once more on stop.
# BACKUP_INTERVAL_HOURS=0 turns them off (any other value: on).
BACKUP_INTERVAL_HOURS=6
BACKUP_DELAY_SEC=30
BACKUP_MAX_DELAY_SEC=300
# A server that starts with no index (a wiped disk, a new host) restores it from
# the pinned backup before serving anything. false = start an empty drive instead.
AUTO_RESTORE=true
# At start, a recent backup not yet handed over may come from a server that is
# still running (a redeploy): wait this long for its final changes.
HANDOVER_WAIT_SEC=60

# ── Performance ──────────────────────────────────────────────────────────────
# Leave these empty to size them from the RAM the server has (a 512 MB free-tier
# instance gets small buffers); values that wouldn't fit are lowered anyway.
CACHE_MEMORY_MB=
CACHE_DISK_GB=
STREAM_READAHEAD_BLOCKS=32
# Readahead memory shared by all downloads at once.
STREAM_BUFFER_MB=
# Override the detected RAM (container limit or machine), in MB.
MEMORY_LIMIT_MB=

# ── Paths ────────────────────────────────────────────────────────────────────
DATA_DIR=./data
PORT=3000
# Build output directory (lets you build while a server runs from .next).
NEXT_DIST_DIR=

# ── Simulator (STORAGE_DRIVER=sim) — chaos knobs for testing ─────────────────
# Where the simulated "channel" lives (default: DATA_DIR/sim).
SIM_DIR=
SIM_BOTS=3
SIM_CONNECTIONS=2
SIM_LATENCY_MS=25
SIM_JITTER_MS=20
SIM_BANDWIDTH_MBPS=0
SIM_FAULT_RATE=0
SIM_FLOOD_RATE=0
SIM_FLOOD_SECONDS=3
SIM_CORRUPT_RATE=0
SIM_DROP_RATE=0
SIM_SLOW_BOT=-1
SIM_STALL_RATE=0
SIM_STALL_MS=1500
SIM_COMMITS_PER_MINUTE=600
