{
  "name": "telestorage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:e2e",
    "tg:setup": "node scripts/telegram-setup.mjs",
    "restore": "node scripts/restore-backup.mjs",
    "reset": "node scripts/reset.mjs"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "^5.104.2",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.17",
    "better-sqlite3": "^13.0.3",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "idb-keyval": "^6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.56.0",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "telegram": "^2.26.22",
    "uqr": "^0.1.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright-core": "^1.52.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "description": "Unlimited personal cloud drive backed by Telegram",
  "engines": {
    "node": ">=22.12"
  }
}
